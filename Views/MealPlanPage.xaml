<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RecipeManager.ViewModels"
             xmlns:models="clr-namespace:RecipeManager.Models"
             xmlns:conv="clr-namespace:RecipeManager.Converters"
             x:Class="RecipeManager.Views.MealPlanPage"
             x:DataType="vm:MealPlanViewModel"
             Title="Weekly Meal Planner"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B0F19}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:MealTypeColorConverter x:Key="MealTypeColorConverter" />
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
            <conv:DaySelectedBgConverter x:Key="DaySelectedBgConverter" />
            <conv:DaySelectedTextConverter x:Key="DaySelectedTextConverter" />
            <conv:DaySelectedSubtextConverter x:Key="DaySelectedSubtextConverter" />
            <conv:DaySelectedBorderConverter x:Key="DaySelectedBorderConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">

        <!-- Top Header & Date Navigator Bar -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" Padding="16,12,16,8" Spacing="8">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="📅 SMART MEAL PLANNER"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#FF5722"
                           CharacterSpacing="1.2" />
                    <Label Text="{Binding FormattedDayHeader}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button Text="◀"
                            Command="{Binding GoToPreviousDayCommand}"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1F2937}"
                            TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                            FontAttributes="Bold"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="8"
                            Padding="0" />

                    <Button Text="Today"
                            Command="{Binding GoToTodayCommand}"
                            BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#371B04}"
                            TextColor="#FF5722"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            CornerRadius="8"
                            Padding="12,0" />

                    <Button Text="▶"
                            Command="{Binding GoToNextDayCommand}"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1F2937}"
                            TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                            FontAttributes="Bold"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="8"
                            Padding="0" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <!-- Interactive Weekly Day Strip (7 Days) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,6,16,6">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeekDays}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayItem">
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{Binding IsSelected, Converter={StaticResource DaySelectedBorderConverter}}"
                                StrokeThickness="1"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DaySelectedBgConverter}}"
                                Padding="12,8"
                                WidthRequest="52">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding DayName}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DaySelectedSubtextConverter}}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DaySelectedTextConverter}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Generate Weekly Grocery List Banner -->
        <Border Grid.Row="2" Margin="16,4,16,6"
                StrokeShape="RoundRectangle 8"
                Stroke="#10B981"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#062B1D}"
                Padding="14,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GenerateWeeklyShoppingListCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Label Text="⚡" FontSize="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Auto-Generate Weekly Grocery List"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#059669" />
                    <Label Text="1-Tap scan all meals this week and auto-add ingredients"
                           FontSize="11"
                           TextColor="#047857" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="Generate →" FontAttributes="Bold" FontSize="12" TextColor="#059669" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Quick Add Meal Slot Form (Responsive 2-row on mobile, 1-row on PC) -->
        <Border Grid.Row="3" Margin="16,2,16,6"
                StrokeShape="RoundRectangle 10"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1F2937}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                Padding="12,10">
            <Grid RowDefinitions="{OnIdiom Phone='Auto, Auto', Desktop='Auto'}"
                  ColumnDefinitions="{OnIdiom Phone='*, Auto, Auto', Desktop='*, 120, Auto, Auto'}"
                  RowSpacing="8"
                  ColumnSpacing="6">
                <!-- Meal Title Entry (Full width on mobile) -->
                <Border Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="{OnIdiom Phone=3, Desktop=1}"
                        StrokeShape="RoundRectangle 6"
                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#374151}"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2937}"
                        Padding="12,0"
                        HeightRequest="40">
                    <Entry Placeholder="Dish name (e.g. Avocado Toast)"
                           Text="{Binding CustomMealTitle}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                           ReturnCommand="{Binding AddCustomMealCommand}" />
                </Border>

                <!-- Meal Type Picker -->
                <Border Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                        StrokeShape="RoundRectangle 6"
                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#374151}"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1F2937}"
                        Padding="8,0"
                        HeightRequest="40">
                    <Picker ItemsSource="{Binding MealTypes}"
                            SelectedItem="{Binding SelectedMealType}"
                            TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                            Title="Meal Slot"
                            FontSize="12" />
                </Border>

                <!-- Schedule Button -->
                <Button Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=1, Desktop=2}"
                        Text="{OnIdiom Phone='➕ Plan Meal', Desktop='➕ Plan'}"
                        Command="{Binding AddCustomMealCommand}"
                        BackgroundColor="#FF5722"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="6"
                        HeightRequest="40"
                        Padding="14,0" />

                <!-- Chef's Surprise Pick Button -->
                <Button Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=2, Desktop=3}"
                        Text="🎲"
                        ToolTipProperties.Text="Chef's surprise meal recommendation"
                        Command="{Binding AutoRecommendMealCommand}"
                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                        TextColor="#4F46E5"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="6"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0" />
            </Grid>
        </Border>

        <!-- Meals List for Selected Day -->
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding MealsForDay}"
                        SelectionMode="None"
                        Margin="16,0,16,16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MealPlanItem">
                    <Border Margin="0,3"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1F2937}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                            Padding="12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <!-- Meal Thumbnail -->
                            <Border StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="64" HeightRequest="64">
                                <Image Source="{Binding RecipeImageUrl}" Aspect="AspectFill" />
                            </Border>

                            <!-- Meal Details -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <HorizontalStackLayout Spacing="6">
                                    <Border StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding MealType, Converter={StaticResource MealTypeColorConverter}}"
                                            Padding="8,2">
                                        <Label Text="{Binding MealType}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="{Binding FormattedDate}"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding RecipeTitle}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Notes}"
                                       FontSize="12"
                                       TextColor="#94A3B8"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyToBoolConverter}}" />
                            </VerticalStackLayout>

                            <!-- Delete Action -->
                            <Button Grid.Column="2"
                                    Text="✕"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealPlanViewModel}}, Path=DeleteMealPlanCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="#EF4444"
                                    FontSize="14"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40" Spacing="10">
                    <Label Text="📅" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="No meals scheduled for this day"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}" />
                    <Label Text="Use the form above or tap 🎲 to let our chef suggest an inspiring meal!"
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

</ContentPage>

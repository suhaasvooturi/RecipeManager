<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RecipeManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RecipeManager.Views"
    Title="Recipes"
    Shell.BackgroundColor="{AppThemeBinding Light=#C4380D, Dark=#1E293B}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.DisabledColor="#94A3B8"
    Shell.UnselectedColor="#94A3B8"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
    Shell.TabBarForegroundColor="#FF5722"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
    Shell.TabBarTitleColor="#FF5722">

    <TabBar>
        <Tab Title="🍽️ Discover">
            <ShellContent
                Title="Discover"
                ContentTemplate="{DataTemplate views:RecipesPage}"
                Route="RecipesPage" />
        </Tab>

        <Tab Title="🛒 Grocery">
            <ShellContent
                Title="Shopping List"
                ContentTemplate="{DataTemplate views:ShoppingListPage}"
                Route="ShoppingListPage" />
        </Tab>

        <Tab Title="📅 Planner">
            <ShellContent
                Title="Meal Planner"
                ContentTemplate="{DataTemplate views:MealPlanPage}"
                Route="MealPlanPage" />
        </Tab>

        <Tab Title="👨‍🍳 CookBook">
            <ShellContent
                Title="My CookBook"
                ContentTemplate="{DataTemplate views:FavoritesPage}"
                Route="FavoritesPage" />
        </Tab>
    </TabBar>

</Shell>
